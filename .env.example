# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Uptime Kuma Configuration
UPTIME_KUMA_URL=http://localhost:3001

# How the bot reads monitor data from Uptime Kuma:
#   websocket (default) - realtime socket.io login, requires USERNAME + PASSWORD below
#   metrics             - polls the /metrics endpoint with an API key (no username/password)
UPTIME_KUMA_MODE=websocket

# Required for UPTIME_KUMA_MODE=websocket
UPTIME_KUMA_USERNAME=admin
UPTIME_KUMA_PASSWORD=your_password_here

# Required for UPTIME_KUMA_MODE=metrics
# Create one in Uptime Kuma: Settings -> API Keys. Used as the /metrics Basic-auth password.
# UPTIME_KUMA_API_KEY=uk1_your_api_key_here

# Bot Configuration
UPDATE_INTERVAL=60
EMBED_COLOR=5814783

# Admin Discord User IDs (comma-separated, can use slash commands)
ADMIN_USER_IDS=

